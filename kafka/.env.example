# MANTHAN 2026 Kafka Ingestion Configuration
# Replace <SERVER_IP> with the actual competition broker IP when provided by organizers.

# Broker connection (<SERVER_IP>:9094)
KAFKA_BOOTSTRAP_SERVERS=<SERVER_IP>:9094

# Security protocol (competition documented as PLAINTEXT)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Assigned consumer group ID (Mandatory format: group-${username})
KAFKA_GROUP_ID=group-mn2651

# Kafka topic subscriptions
KAFKA_TOPIC_TICKS=market.ticks
KAFKA_TOPIC_NEWS=market.news

# Offset reset behavior: 'latest' (default for live streaming) or 'earliest' (replay)
KAFKA_AUTO_OFFSET_RESET=latest

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional Offset Commit & Performance Tuning
# KAFKA_ENABLE_AUTO_COMMIT=true
# KAFKA_AUTO_COMMIT_INTERVAL_MS=5000
# KAFKA_SESSION_TIMEOUT_MS=45000
# KAFKA_MAX_POLL_INTERVAL_MS=300000

